{
  "_comment": "R-F1941 grounded-SFT config. Trains on the 664-example grounded corpus (chat-messages, grounded/abstain labels). Base model is a lever for beating DeepSeek 0.34 — Qwen2.5-7B/14B-Instruct are stronger alternatives.",
  "model_name": "mistralai/Mistral-7B-Instruct-v0.3",
  "dataset_file": "data/training/aria_grounded_v1.jsonl",
  "dataset_format": "chat_messages",
  "method": "qlora",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "learning_rate": 0.0001,
  "batch_size": 2,
  "grad_accum_steps": 8,
  "num_epochs": 3,
  "max_seq_length": 4096,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "eval_split": 0.1,
  "seed": 42,
  "completion_only_loss": true,
  "bf16": true,
  "gradient_checkpointing": true,
  "logging_steps": 10,
  "save_steps": 50,
  "output_dir": "data/training/checkpoints/aria_llm_grounded_v1"
}
