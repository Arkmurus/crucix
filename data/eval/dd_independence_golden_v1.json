{
  "description": "R-F2666 — golden set for DD independent-source corroboration (C-3). Each case is a claim + its supporting source identifiers + the GROUND-TRUTH `expected` (is it backed by >=2 genuinely-INDEPENDENT external origins?). The FALSE-POSITIVE rate (classifier says corroborated when expected=false) is the GATE for ever flipping independent_source_verification_run (R-F2413): it MUST be 0 — a claim mislabelled 'independently verified' is the exact USP betrayal. False negatives (conservative undercount) are acceptable for C-3 v1; closing them (real domain/family/wire modelling) is C-3 v2's target while holding FP=0.",
  "gate": {"metric": "false_positive_rate", "must_be": 0.0},
  "cases": [
    {"id": "multi_sanctions_authorities", "claim": "entity is sanctioned",
     "sources": ["sanctions:ofac", "sanctions:ofsi", "sanctions:un"],
     "expected": true, "rationale": "3 distinct independent sanctions authorities"},
    {"id": "multi_country_indices", "claim": "country risk headline",
     "sources": ["transparency_intl_cpi", "basel_aml_index", "fatf", "worldbank_wgi"],
     "expected": true, "rationale": "4 distinct independent risk indices"},
    {"id": "two_registries", "claim": "cross-registry identity",
     "sources": ["companies_house", "sec_edgar"],
     "expected": true, "rationale": "two independent company registries"},
    {"id": "registry_plus_one_press", "claim": "incorporation corroborated",
     "sources": ["companies_house", "ft.com"],
     "expected": true, "rationale": "registry + an independent publisher = 2 independent origins"},
    {"id": "genuine_multi_publisher", "claim": "press mention",
     "sources": ["bbc.co.uk", "theguardian.com", "ft.com", "nytimes.com"],
     "expected": true, "rationale": "4 distinct independent publishers (v2 must catch; v1 undercounts)"},
    {"id": "single_registry", "claim": "directors known",
     "sources": ["companies_house"],
     "expected": false, "rationale": "one source, not corroborated"},
    {"id": "internal_compute_only", "claim": "ghost + network score",
     "sources": ["ghost_scorer", "network_walker"],
     "expected": false, "rationale": "ARIA's OWN compute engines — not external witnesses"},
    {"id": "internal_memory_echo", "claim": "kb + neural recall",
     "sources": ["aria_knowledge", "neural_memory"],
     "expected": false, "rationale": "internal memory echo — never independent"},
    {"id": "one_external_plus_internal", "claim": "mixed single external",
     "sources": ["companies_house", "aria_knowledge"],
     "expected": false, "rationale": "one external + internal echo = one independent origin"},
    {"id": "wire_syndication", "claim": "press mention",
     "sources": ["reuters.com", "uk.reuters.com", "somepaper.com/reuters-wire-story"],
     "expected": false, "rationale": "ONE Reuters wire story syndicated — not independent origins"},
    {"id": "same_publisher_family", "claim": "press mention",
     "sources": ["bbc.com", "bbc.co.uk"],
     "expected": false, "rationale": "same publisher family — one origin"},
    {"id": "no_sources", "claim": "unbacked assertion",
     "sources": [],
     "expected": false, "rationale": "no sources"}
  ]
}
