# aria-app environment. No Supabase / OpenAI / S3 — auth + data come from the existing backend.
# The browser is SAME-ORIGIN: /api/* is proxied to BACKEND_URL by next.config rewrites,
# so no NEXT_PUBLIC_* backend URL is needed (the backend host never reaches the browser).

# Backend (server.mjs) base URL — used by the API proxy (build time) + server fetches (runtime).
#  - local dev:  http://localhost:3117
#  - fly:        http://aria-web.internal:3117   (set via fly.app.toml build arg + env)
BACKEND_URL=http://localhost:3117
