# aria-app environment. No Supabase / OpenAI / S3 — auth + data come from the existing backend.

# Backend (server.mjs) base URL.
#  - local dev:  http://localhost:3117
#  - fly:        http://aria-web.internal:3117   (set as a fly secret/env, server-side only)
BACKEND_URL=http://localhost:3117

# Browser-visible backend base for client fetches (sign-in). Same-origin if proxied; else full URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3117
