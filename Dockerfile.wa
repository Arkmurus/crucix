# R-F833 (2026-05-23) — Dockerfile for the `aria-wa` Fly app.
#
# Isolates the Baileys WhatsApp listener as its own Fly machine so a
# WA crash never takes down web/auth/billing. Per audit W15: the
# standalone `services/wa-listener/aria_wa_listener.mjs` is the
# canonical implementation — the embedded `lib/whatsapp/waListener.mjs`
# in server.mjs gets deleted in R-F832.
#
# Persistent Fly volume holds Baileys session auth (the QR-scan blob)
# so a deploy doesn't force a QR re-scan. Operator scans QR ONCE
# during R-F833 first boot; subsequent deploys reuse the auth.

FROM node:22-slim

# Build deps for native modules (baileys uses libsignal + bufferutil)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# IMPORTANT — directory layout MUST mirror the repo so the listener's
# relative import `../../lib/aria/complianceAudit.mjs` resolves correctly.
# Final container layout:
#   /app/services/wa-listener/aria_wa_listener.mjs    (CWD entrypoint)
#   /app/services/wa-listener/package.json + node_modules/
#   /app/lib/aria/complianceAudit.mjs                  (cross-module dep)

# Listener's OWN package.json + node_modules (separate dep tree)
# R-F3391 — `npm install` against `"baileys": "latest"` with no lockfile meant
# every build resolved the dependency afresh. Production ended up on
# 7.0.0-rc13 — a RELEASE CANDIDATE nobody chose or reviewed — while the dev tree
# sat on 6.7.23, so local testing did not reflect production at all. `npm ci`
# installs exactly what the lockfile records, which is what makes a build
# reproducible and an upgrade a deliberate act.
COPY services/wa-listener/package.json ./services/wa-listener/package.json
COPY services/wa-listener/package-lock.json ./services/wa-listener/package-lock.json
RUN cd services/wa-listener && npm ci --omit=dev

# WA listener source
COPY services/wa-listener/aria_wa_listener.mjs ./services/wa-listener/aria_wa_listener.mjs

# R-F2946 — the listener imports `./wa-watchdog.mjs` (pure open-but-dead decision logic).
# Same sibling-file cherry-pick trap as below: MISSING it crash-loops aria-wa
# (ERR_MODULE_NOT_FOUND on boot). Dependency-free (Node only).
COPY services/wa-listener/wa-watchdog.mjs ./services/wa-listener/wa-watchdog.mjs

# R-F2069 — the listener imports `./send-retry.mjs` (extracted bounded send retry).
# Same sibling-file cherry-pick trap as the lib/ copies below: MISSING it
# crash-loops aria-wa (ERR_MODULE_NOT_FOUND on boot). Dependency-free (Node only).
COPY services/wa-listener/send-retry.mjs ./services/wa-listener/send-retry.mjs

# R-F2070 — the listener imports `./doc-resubmit.mjs` (auto-resubmit a died doc
# extraction). Same sibling-file cherry-pick trap: MISSING it crash-loops aria-wa
# (ERR_MODULE_NOT_FOUND on boot). Dependency-free (Node only).
COPY services/wa-listener/doc-resubmit.mjs ./services/wa-listener/doc-resubmit.mjs

# R-F2705 — the listener imports `./log-redact.mjs` (recursive secret redaction
# applied before pino serializes any object — scrubs signal/session key material).
# Same sibling-file cherry-pick trap: MISSING it crash-loops aria-wa
# (ERR_MODULE_NOT_FOUND on boot). Dependency-free (Node only).
COPY services/wa-listener/log-redact.mjs ./services/wa-listener/log-redact.mjs

# R-F3578 — shared linked-device scope/expiry policy. Both web and aria-wa use
# this exact module so the internal service cannot be reached around web consent.
COPY lib/whatsapp/waGovernance.mjs ./lib/whatsapp/waGovernance.mjs

# R-F3587 — shared phone<->account binding policy. Both tiers import this exact
# file so they cannot disagree about who is verified. Without this COPY the
# listener dies at boot on module-not-found: a total WhatsApp outage, caught
# before deploy by the R-F2069 import/COPY guard.
COPY lib/whatsapp/waBinding.mjs ./lib/whatsapp/waBinding.mjs

# Cross-module dependency: the listener imports `../../lib/aria/complianceAudit.mjs`.
# That file only uses Node stdlib (fs/path/url), so copying just it is safe.
COPY lib/aria/complianceAudit.mjs ./lib/aria/complianceAudit.mjs

# R-F1970 — the listener imports `../../lib/aria/deliveryOutcome.mjs` (R-F1965 §25
# delivery-outcome classifier). Dependency-free (reads plain result objects), so
# copying just it is safe. MISSING it crash-looped aria-wa (ERR_MODULE_NOT_FOUND)
# — the exact "new ../../lib import must be added here" trap noted below.
COPY lib/aria/deliveryOutcome.mjs ./lib/aria/deliveryOutcome.mjs

# R-F1819: the listener also imports `../../lib/observability/errorTracker.mjs`
# (R-F1802 circuit breaker). Like complianceAudit it is stdlib-only (crypto), so
# copy just it. Without this the import falls to R-F1810's fail-open guard and the
# breaker is silently DISABLED (the recurring "errorTracker unavailable" boot log).
# NOTE: this Dockerfile cherry-picks lib files — any NEW ../../lib import added to
# the listener must be added here too (a `COPY lib/ ./lib/` would avoid that, at
# the cost of a larger image surface).
COPY lib/observability/errorTracker.mjs ./lib/observability/errorTracker.mjs

# Volume mount point — Baileys auth + session blobs (persists on the
# aria_wa_data volume mounted at /data by fly.wa.toml).
RUN mkdir -p /data/wa-auth

# R-F866 (2026-05-25) — the env var name MUST be WA_LISTENER_AUTH_DIR: that is
# the variable aria_wa_listener.mjs:97 actually reads (it defaults to the
# EPHEMERAL ./wa-listener-auth when unset). Pre-R-F866 this was WHATSAPP_AUTH_DIR
# — a name the listener never reads — so Baileys auth was written to the
# ephemeral container path and WIPED on every restart, forcing a fresh QR scan
# after every deploy and dropping WhatsApp into a perpetual 408 QR-rescan loop.
# Pointing the CORRECT var at the /data volume makes the session survive
# restarts (scan the QR once, stays linked).
# R-F3666 — build-time identity (mirrors aria-intel R-F513 / aria-web R-F846).
# aria_wa_listener.mjs reads these at boot so GET /health reports build_rev.
# Without them no aria-wa deploy could be verified live, which is exactly what
# CLAUDE.md §11 requires before an R-number may be ship-marked.
ARG ARIA_BUILD_GIT_SHA=unknown
ARG ARIA_BUILD_R_TAG=

ENV WA_LISTENER_AUTH_DIR=/data/wa-auth \
    NODE_ENV=production \
    PORT=5070 \
    ARIA_BUILD_GIT_SHA=$ARIA_BUILD_GIT_SHA \
    ARIA_BUILD_R_TAG=$ARIA_BUILD_R_TAG

EXPOSE 5070

WORKDIR /app/services/wa-listener
CMD ["node", "aria_wa_listener.mjs"]
