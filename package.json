{
  "name": "aria",
  "version": "2.0.3",
  "description": "ARIA \u2014 defence and compliance intelligence platform: live OSINT, sanctions, procurement and vault-curated sources fused into structured, evidence-graded due-diligence reports with source health and confidence on every material finding.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop crucix",
    "logs:pm2": "pm2 logs crucix",
    "dev": "node --trace-warnings server.mjs",
    "sweep": "node apis/briefing.mjs",
    "inject": "node dashboard/inject.mjs",
    "brief": "node apis/briefing.mjs",
    "brief:save": "node apis/save-briefing.mjs",
    "diag": "node diag.mjs",
    "clean": "node scripts/clean.mjs",
    "seed:outcomes": "node scripts/seed_outcomes.mjs",
    "fresh-start": "npm run clean && npm start",
    "lint": "node scripts/lint.mjs",
    "lint:changed": "node scripts/lint.mjs --changed",
    "lint:js": "eslint .",
    "gate:auth": "node scripts/admin/auth_egress_gate.mjs",
    "gate:arity": "python scripts/admin/call_arity_gate.py",
    "test": "node --test --test-force-exit --test-concurrency=2 --import ./test/helpers/net_guard.mjs \"test/**/*.test.mjs\"",
    "test:offline": "node --test --test-force-exit --test-concurrency=2 --import ./test/helpers/net_guard.mjs \"test/**/*.test.mjs\"",
    "test:live": "node --test --test-force-exit --test-concurrency=2 \"test/**/*.test.mjs\""
  },
  "keywords": [
    "osint",
    "intelligence",
    "dashboard",
    "geopolitical"
  ],
  "author": "ARIA Intelligence Limited",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3",
    "express": "^5.1.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.6.2",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "discord.js": "^14.27.0",
    "imap": "^0.8.19",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "stripe": "^17.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "undici": "^7.29.0",
    "ip-address": "^10.4.0",
    "socket.io-parser": "^4.2.7",
    "body-parser": "^2.3.0",
    "utf7": {
      "semver": "^7.8.5"
    },
    "@whiskeysockets/baileys": {},
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  }
}
