#!/usr/bin/env python
"""R-F1070/R-F1073 — Pre-commit hook: verify function names in staged changes.

This script is run by git's pre-commit hook (via core.hooksPath).
It checks every `await module.function()` call in staged diffs against
the actual function definitions in the target module.

Testable logic is in scripts/pre_commit_checks.py (R-F1127).

Usage:
    python scripts/pre-commit              # check staged changes (pre-commit)
    python scripts/pre-commit --check-all  # check all committed .py files (CI)
    python scripts/pre-commit --install    # install via core.hooksPath

Exit code: 0 if clean, 1 if issues found.
"""
import os
import subprocess
import sys
from pathlib import Path

# Import testable logic from the shared module
_REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, encoding="utf-8", check=True
    ).stdout.strip()
)
sys.path.insert(0, str(_REPO_ROOT / "scripts"))
from pre_commit_checks import (
    ARIA_SERVICE,
    REPO_ROOT,
    check_builtin_shadowing,   # R-F1958 — was CALLED (line ~195) but NOT imported → NameError crashed the whole checker on every run, so NO checks ran even before the hooks-path orphaning. Import it so the checker completes.
    check_syntax,              # R-F2127 — fail-fast syntax gate (a broken .py must never commit)
    check_capability_tests,
    check_circuit_breaker,
    check_no_token_default,
    check_ssrf_fetch_boundary,
    check_false_success,
    check_windows_compat,
    check_wiring_present,
    find_direct_function_calls,
    find_function_calls,
    function_exists,
    resolve_module,
)


def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    files = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if line.endswith(".py") and (REPO_ROOT / line).exists():
            files.append(REPO_ROOT / line)
    return files


def get_staged_diff(path):
    rel = path.relative_to(REPO_ROOT)
    result = subprocess.run(
        ["git", "diff", "--cached", str(rel)],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    return result.stdout


def extract_added_lines(diff):
    added = []
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            added.append(line[1:])
    return added


def added_line_numbers(diff):
    """R-F1961 — new-file line numbers that were ADDED in the staged diff, by
    walking the unified-diff hunks. Lets the whole-file checks gate ONLY what this
    commit adds (not pre-existing debt in a touched legacy file)."""
    import re as _re
    nums = set()
    new_ln = 0
    for line in diff.splitlines():
        if line.startswith("@@"):
            m = _re.search(r"\+(\d+)", line)
            if m:
                new_ln = int(m.group(1))
            continue
        if line.startswith("+++") or line.startswith("---"):
            continue
        if line.startswith("+"):
            nums.add(new_ln)
            new_ln += 1
        elif line.startswith("-"):
            continue  # removed line — new-file numbering doesn't advance
        else:
            new_ln += 1  # context line
    return nums


def added_func_names(diff):
    """R-F1961 — names of functions whose `def` is in the ADDED lines."""
    import re as _re
    names = set()
    for line in extract_added_lines(diff):
        m = _re.match(r"^\s*(?:async\s+)?def\s+(\w+)\s*\(", line)
        if m:
            names.add(m.group(1))
    return names


def check_all_files() -> list[str]:
    """Check ALL Python files in the repo (CI mode)."""
    issues = []
    for py_file in ARIA_SERVICE.rglob("*.py"):
        if "tests" in py_file.parts or "__pycache__" in py_file.parts:
            continue
        try:
            content = py_file.read_text(encoding="utf-8")
        except Exception:
            continue
        lines = content.splitlines()
        calls = find_function_calls(lines)
        for call in calls:
            module_path = resolve_module(call["object"], py_file)
            if module_path is None:
                continue
            if not function_exists(module_path, call["function"]):
                rel = py_file.relative_to(REPO_ROOT)
                issue = (
                    f"  {rel}:{call['line_num']} — {call['code']}\n"
                    f"    Function '{call['function']}()' not found in {module_path}"
                )
                if issue not in issues:
                    issues.append(issue)
    return issues


def install_hook() -> bool:
    """Install the pre-commit hook via core.hooksPath."""
    hooks_dir = REPO_ROOT / "scripts" / "githooks"
    hook_path = hooks_dir / "pre-commit"
    if not hook_path.exists():
        print(f"[pre-commit] ERROR: {hook_path} not found")
        return False
    result = subprocess.run(
        ["git", "config", "core.hooksPath", str(hooks_dir)],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    if result.returncode == 0:
        print(f"[pre-commit] Installed: core.hooksPath = {hooks_dir}")
        return True
    print(f"[pre-commit] Install failed: {result.stderr}")
    return False


def main():
    if "--install" in sys.argv:
        return 0 if install_hook() else 1

    if "--check-all" in sys.argv:
        print("[pre-commit] Running --check-all (CI mode)...")
        issues = check_all_files()
        if issues:
            print("[pre-commit] FUNCTION VERIFICATION FAILED:")
            for issue in issues[:30]:
                print(issue)
            if len(issues) > 30:
                print(f"  ... and {len(issues) - 30} more")
            return 1
        print(f"[pre-commit] OK — all files checked, no issues.")
        return 0

    # Default: check staged changes (pre-commit hook mode)
    files = get_staged_files()
    if not files:
        return 0

    # Check 0: SYNTAX GATE (R-F2127) — fail-fast. A staged .py with a SyntaxError
    # must NEVER be committed: it breaks import and any deploy. Every other check
    # below ast.parse()s and silently skips broken files, so without this gate a
    # corrupted file (e.g. an autonomous annotation campaign inserting comments
    # mid-expression) sails through. Run FIRST and short-circuit — other checks
    # are unreliable on a file that doesn't parse.
    syntax_issues = check_syntax(files)
    if syntax_issues:
        print("[pre-commit] VERIFICATION FAILED:")
        for issue in syntax_issues:
            print(issue)
        print("\nFix the SyntaxError(s) above before committing — broken Python breaks import + any deploy.")
        return 1

    # R-F1961 — per-file ADDED-line numbers + ADDED function names, so the
    # whole-file checks gate only what THIS commit introduces (not pre-existing
    # debt in a touched legacy file). Empty maps fall back to whole-file behavior.
    added_lines_by_file = {}
    changed_funcs = {}
    for fp in files:
        _d = get_staged_diff(fp)
        added_lines_by_file[fp.name] = added_line_numbers(_d)
        changed_funcs[fp.name] = added_func_names(_d)

    issues = []

    # Check 1: Function-name verification (existing)
    for file_path in files:
        diff = get_staged_diff(file_path)
        if not diff:
            continue
        added_lines = extract_added_lines(diff)
        calls = find_function_calls(added_lines)
        for call in calls:
            module_path = resolve_module(call["object"], file_path)
            if module_path is None:
                continue
            if not function_exists(module_path, call["function"]):
                rel = file_path.relative_to(REPO_ROOT)
                issues.append(f"  {rel}:{call['line_num']} — {call['code']}")
                issues.append(f"    Function '{call['function']}()' not found in {module_path}")

    # Check 2: Capability test requirement (R-F1124) — R-F1961: ADDED funcs only
    cap_issues = check_capability_tests(files, changed_funcs)
    issues.extend(cap_issues)

    # Check 3: Wiring presence (R-F1268) — whole-file (a module is wired or not)
    wiring_issues = check_wiring_present(files)
    issues.extend(wiring_issues)

    # Check 4: Windows compatibility (R-F1268) — R-F1961: ADDED lines only
    win_issues = check_windows_compat(files, added_lines_by_file)
    issues.extend(win_issues)

    # Check 5: False success detection (R-F1268) — R-F1961: ADDED lines only
    fs_issues = check_false_success(files, added_lines_by_file)
    issues.extend(fs_issues)

    # Check 6: Direct function call verification (R-F1268)
    for file_path in files:
        diff = get_staged_diff(file_path)
        if not diff:
            continue
        added_lines = extract_added_lines(diff)
        calls = find_direct_function_calls(added_lines)
        for call in calls:
            module_path = resolve_module(call["object"], file_path)
            if module_path is None:
                continue
            if not function_exists(module_path, call["function"]):
                rel = file_path.relative_to(REPO_ROOT)
                issues.append(f"  {rel}:{call['line_num']} — {call['code']}")
                issues.append(f"    Function '{call['function']}()' not found in {module_path}")

    # Check 7: Built-in shadowing (R-F1518)
    shadow_issues = check_builtin_shadowing(files)
    issues.extend(shadow_issues)

    # Check 8: Circuit-breaker presence on outbound HTTP backends (R-F1791)
    cb_issues = check_circuit_breaker(files)
    issues.extend(cb_issues)

    # Check 9: No hardcoded auth-token default — fail closed (R-F1824, audit H2)
    issues.extend(check_no_token_default(files))

    # Check 10: SSRF fetch-boundary on user-controlled URLs (R-F1824, audit C2)
    issues.extend(check_ssrf_fetch_boundary(files))

    if issues:
        print("[pre-commit] VERIFICATION FAILED:")
        for issue in issues:
            print(issue)
        print("\nFix the issues above before committing.")
        return 1

    print(f"[pre-commit] OK — {len(files)} files checked.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
