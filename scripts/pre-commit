#!/usr/bin/env python
"""R-F1070/R-F1073 — Pre-commit hook: verify function names in staged changes.

This script is run by git's pre-commit hook (via core.hooksPath).
It checks every `await module.function()` call in staged diffs against
the actual function definitions in the target module.

Testable logic is in scripts/pre_commit_checks.py (R-F1127).

Usage:
    python scripts/pre-commit              # check staged changes (pre-commit)
    python scripts/pre-commit --check-all  # check all committed .py files (CI)
    python scripts/pre-commit --install    # install via core.hooksPath

Exit code: 0 if clean, 1 if issues found.
"""
import os
import re  # R-F3683 — committed-secret gate
import subprocess
import sys
from pathlib import Path

# Import testable logic from the shared module
_REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, encoding="utf-8", check=True
    ).stdout.strip()
)
sys.path.insert(0, str(_REPO_ROOT / "scripts"))
from pre_commit_checks import (
    KNOWN_DEAD_CALLS,
    _is_capability_guarded,
    ARIA_SERVICE,
    REPO_ROOT,
    check_builtin_shadowing,   # R-F1958 — was CALLED (line ~195) but NOT imported → NameError crashed the whole checker on every run, so NO checks ran even before the hooks-path orphaning. Import it so the checker completes.
    check_c_number_collisions,     # R-F3878 — a C-number claimed by writing a heading is not claimed (§2)
    check_syntax,              # R-F2127 — fail-fast syntax gate (a broken .py must never commit)
    check_capability_test_present,  # R-F2135 — structural guard for AGENTS.md §8.7
    check_capability_tests,
    check_circuit_breaker,
    check_no_token_default,
    check_powershell_safety,       # R-F2135 — structural guard for anti-hallucination law 19
    check_ssrf_fetch_boundary,
    check_false_success,
    check_windows_compat,
    check_wiring_present,
    find_direct_function_calls,
    find_function_calls,
    function_exists,
    resolve_module,
)


def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    files = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not (REPO_ROOT / line).exists():
            continue
        # R-F2136: include .ps1, .sh, .md for PowerShell safety checks
        if line.endswith(".py") or line.endswith(".ps1") or line.endswith(".sh") or line.endswith(".md"):
            files.append(REPO_ROOT / line)
    return files


def get_staged_diff(path):
    rel = path.relative_to(REPO_ROOT)
    result = subprocess.run(
        ["git", "diff", "--cached", str(rel)],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    return result.stdout


def extract_added_lines(diff):
    added = []
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            added.append(line[1:])
    return added


def added_line_numbers(diff):
    """R-F1961 — new-file line numbers that were ADDED in the staged diff, by
    walking the unified-diff hunks. Lets the whole-file checks gate ONLY what this
    commit adds (not pre-existing debt in a touched legacy file)."""
    import re as _re
    nums = set()
    new_ln = 0
    for line in diff.splitlines():
        if line.startswith("@@"):
            m = _re.search(r"\+(\d+)", line)
            if m:
                new_ln = int(m.group(1))
            continue
        if line.startswith("+++") or line.startswith("---"):
            continue
        if line.startswith("+"):
            nums.add(new_ln)
            new_ln += 1
        elif line.startswith("-"):
            continue  # removed line — new-file numbering doesn't advance
        else:
            new_ln += 1  # context line
    return nums


def added_func_names(diff):
    """R-F1961 — names of functions whose `def` is in the ADDED lines."""
    import re as _re
    names = set()
    for line in extract_added_lines(diff):
        m = _re.match(r"^\s*(?:async\s+)?def\s+(\w+)\s*\(", line)
        if m:
            names.add(m.group(1))
    return names


def _check_compile_gate(files: list[Path]) -> list[str]:
    """R-F2135 — Fail the commit if any staged .py has a compile error.

    Runs python -c "compile(open(path).read(), path, 'exec')" on each staged
    .py file (excluding tests). This catches SyntaxError that ast.parse()
    might miss (encoding issues, null bytes) — the same class as R-F2126.

    NOTE: This does NOT catch undefined names or import errors — that requires
    actually importing the module, which is too expensive for a pre-commit hook.
    The syntax gate (check_syntax) already catches SyntaxError via ast.parse;
    this is a belt-and-suspenders check using the CPython compiler directly.

    Returns a list of issue strings (empty if all pass).
    """
    issues = []
    for fp in files:
        if fp.suffix != ".py":
            continue
        if "tests" in fp.parts:
            continue
        # Use compile() via subprocess to avoid importing the module.
        # R-F2168: read as UTF-8 (Python source default per PEP 3120). Without
        # the explicit encoding, open() used the OS locale (cp1252 on Windows)
        # and raised UnicodeDecodeError on any valid file containing box-drawing
        # / em-dash chars — a false COMPILE-GATE failure on perfectly good code.
        code = f"compile(open({str(fp)!r}, encoding='utf-8').read(), {str(fp)!r}, 'exec')"
        result = subprocess.run(
            [sys.executable, "-c", code],
            capture_output=True, text=True, encoding="utf-8",
            cwd=REPO_ROOT,
        )
        if result.returncode != 0:
            try:
                rel = fp.relative_to(REPO_ROOT)
            except ValueError:
                rel = fp
            stderr = result.stderr.strip()[:300]
            issues.append(
                f"  {rel} — COMPILE ERROR\n"
                f"    {stderr}\n"
                f"    A broken .py must NEVER be committed (CLAUDE.md §11c)."
            )
    return issues


def check_all_files() -> list[str]:
    """Check ALL Python files in the repo (CI mode)."""
    issues = []
    for py_file in ARIA_SERVICE.rglob("*.py"):
        if "tests" in py_file.parts or "__pycache__" in py_file.parts:
            continue
        try:
            content = py_file.read_text(encoding="utf-8")
        except Exception:
            continue
        lines = content.splitlines()
        calls = find_function_calls(lines)
        for call in calls:
            module_path = resolve_module(call["object"], py_file, call.get("line_num"))
            if module_path is None:
                continue
            if _is_capability_guarded(lines, call["line_num"], call["function"]):
                continue
            # R-F3556 — known dead branches: reported, not fatal, shrink-only.
            if (module_path, call["function"]) in KNOWN_DEAD_CALLS:
                continue
            if not function_exists(module_path, call["function"]):
                rel = py_file.relative_to(REPO_ROOT)
                issue = (
                    f"  {rel}:{call['line_num']} — {call['code']}\n"
                    f"    Function '{call['function']}()' not found in {module_path}"
                )
                if issue not in issues:
                    issues.append(issue)
    # R-F4069 (C-123) — run the builtin-shadow guard in CI too.
    #
    # It was called ONLY from the staged-commit path (below), so `--check-all`
    # reported "OK — all files checked, no issues" on the exact tree whose
    # commit the hook then BLOCKED. Two modes, two answers, same code: the same
    # fork this file already records ~line 536 for a different guard, and the
    # same shape §1 records for the Phase A gate aggregators.
    #
    # Safe to enable: with R-F4069's module-level scoping and the narrow
    # allowlist, the whole tree has zero violations (measured — 1 real
    # module-level shadow, allowlisted; 31 method-level false positives, gone).
    shadow_files = [p for p in ARIA_SERVICE.rglob("*.py")
                    if "__pycache__" not in p.parts]
    issues.extend(f"  {s}" for s in check_builtin_shadowing(shadow_files))
    return issues


# ── R-F3683 — committed-secret gate ─────────────────────────────────────────
#
# THE DEFECT: scripts/verify_all.py:5 and scripts/check_mastery.py:5 each held
#   TOKEN = '<43-char live bearer token>'
# and sent it as `Authorization: Bearer` to aria-intel.fly.dev. Both were
# TRACKED IN GIT, so the credential is in history regardless of deletion, and
# anyone with repo read access held a key to ~700 brain endpoints.
#
# Deleting the two literals fixes today. This gate is what stops tomorrow:
# constitutional rule `no-hardcoded-token-default-fail-closed` says secrets must
# fail closed and never be a hardcoded default, and nothing enforced it.
#
# Deliberately NOT skipping tests/: the leaked token was ALSO sitting in
# aria_cli/tests/test_rf2796_terminal_secret_redaction.py:55 as a redaction
# fixture. A redaction test does not need a real credential, and exempting
# tests is how the real one got a second home.
# NOTE the leading `[A-Za-z0-9_]*` is OPTIONAL. An earlier draft required one
# character before the keyword (`[A-Za-z_][A-Za-z0-9_]*`), which silently failed
# to match a BARE `TOKEN = '...'` — i.e. the exact shape of the credential this
# gate exists for. The capability test caught it; without that test this gate
# would have shipped looking correct and catching nothing.
_SECRET_NAME_PART = (
    r"[A-Za-z0-9_]*(?:TOKEN|SECRET|APIKEY|API_KEY|PASSWORD|PASSWD|BEARER)[A-Za-z0-9_]*"
)

# Shape 1 — a source assignment:  TOKEN = 'abc…'  /  const TOKEN = "abc…"
_SECRET_NAME_RE = re.compile(
    r"\b(" + _SECRET_NAME_PART + r")\b\s*[:=]\s*"
    r"""['"]([A-Za-z0-9_\-]{20,})['"]""",
    re.IGNORECASE,
)

# Shape 2 — an env-style assignment, including one embedded INSIDE a string
# literal:  "ARIA_API_TOKEN=abc…"  /  export ANTHROPIC_API_KEY=sk-…
# This shape is not optional: the live token this gate exists for appeared in
# BOTH shapes — as `TOKEN = '…'` in two scripts and as `"ARIA_API_TOKEN=…"` in a
# test fixture. A gate that only caught the first would have left the second.
#
# Deliberately CASE-SENSITIVE and upper-only: env var names are uppercase by
# convention, and a case-insensitive version matched Python keyword arguments
# — `max_tokens=_completion_max_tokens(...)`, `input_tokens=_billable_...` —
# flagging four token-COUNT call sites as credentials. Measured on the real
# tree; a gate that cries wolf on aria_engine.py gets switched off.
_SECRET_ENV_RE = re.compile(
    r"\b([A-Z0-9_]*(?:TOKEN|SECRET|APIKEY|API_KEY|PASSWORD|PASSWD|BEARER)[A-Z0-9_]*)"
    r"=([A-Za-z0-9_\-]{20,})",
)

# Values that are obviously not credentials. Kept tight — a broad allowlist is
# how a gate becomes decorative.
_SECRET_PLACEHOLDER_RE = re.compile(
    r"^(?:your[-_]|xxx|placeholder|changeme|replace|example|dummy|fake|test[-_]?token|"
    r"sk[-_]test|<|\$\{|process\.env|os\.environ)",
    re.IGNORECASE,
)

# Explicit, greppable opt-outs for the rare legitimate case. The file-level form
# exists for redaction/parser FIXTURES, which must contain credential-shaped
# strings to be worth anything — the alternative is a pragma on every line, which
# people delete. A file declaring itself is auditable: `grep -r allowlist-secret`.
_SECRET_PRAGMA = "allowlist-secret"
_SECRET_PRAGMA_FILE = "allowlist-secret-file"

_SECRET_SCAN_SUFFIXES = {".py", ".mjs", ".js", ".cjs", ".ts", ".sh", ".ps1"}


def _looks_like_placeholder(value: str) -> bool:
    if _SECRET_PLACEHOLDER_RE.match(value):
        return True
    # 'aaaaaaaa...' / '000000...' carry no entropy.
    if len(set(value)) <= 4:
        return True
    # ── The credential signature, calibrated against the real leak ──────────
    # A machine-generated credential (secrets.token_urlsafe, base64, an API key)
    # essentially always mixes upper, lower AND digits. A human-written test
    # label does not: measured on this tree, the flagged values were
    # 'vetting-compliance-token', 'rf1839-contract-token',
    # 'sufficiently-long-pw', 'ghp_abcdef1234567890...' — none has an uppercase
    # letter. The credential that actually leaked,
    # 'TPWspa3T5esw2YVh5Y7wemddnSSiLQAxZUz120u5uvk', has all three, so this
    # narrows false positives WITHOUT weakening the case the gate exists for.
    #
    # This is the one rule to re-check if a real secret ever slips through: a
    # lowercase-plus-digits-only credential (some hex keys) would be missed.
    # Prefer adding a targeted pattern for that format over deleting this.
    if not (any(c.isupper() for c in value)
            and any(c.islower() for c in value)
            and any(c.isdigit() for c in value)):
        return True
    return False


def check_committed_secrets(paths) -> list[str]:
    """Refuse any credential-shaped literal assigned to a secret-shaped name."""
    issues: list[str] = []
    for fp in paths:
        if fp.suffix.lower() not in _SECRET_SCAN_SUFFIXES:
            continue
        if "__pycache__" in fp.parts or "node_modules" in fp.parts:
            continue
        try:
            text = fp.read_text(encoding="utf-8")
        except Exception:
            continue
        if _SECRET_PRAGMA_FILE in text:
            continue
        for num, line in enumerate(text.splitlines(), 1):
            if _SECRET_PRAGMA in line:
                continue
            m = _SECRET_NAME_RE.search(line) or _SECRET_ENV_RE.search(line)
            if not m:
                continue
            name, value = m.group(1), m.group(2)
            if _looks_like_placeholder(value):
                continue
            try:
                rel = fp.relative_to(REPO_ROOT)
            except ValueError:
                rel = fp
            issues.append(
                f"  {rel}:{num} — {name} = '{value[:6]}…{value[-4:]}' "
                f"({len(value)} chars)\n"
                f"    A credential-shaped literal must not be committed. Read it "
                f"from the environment instead:\n"
                f"      {name} = os.environ['{name}']   (Python)\n"
                f"      const {name} = process.env.{name};   (Node)\n"
                f"    If this genuinely is not a secret, append the comment "
                f"'{_SECRET_PRAGMA}' to the line."
            )
    return issues


def _all_repo_source_files():
    """Every source file the secret gate covers, repo-wide (CI mode)."""
    skip_dirs = {".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build"}
    for path in REPO_ROOT.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in _SECRET_SCAN_SUFFIXES:
            continue
        if skip_dirs & set(path.parts):
            continue
        yield path


def install_hook() -> bool:
    """Install the pre-commit hook via core.hooksPath.

    R-F3896 — THIS POINTED AT THE WRONG DIRECTORY, AND IT IS THE VERY DIRECTORY
    R-F1958 WAS WRITTEN ABOUT. That fix's own docstring says:

        "core.hooksPath is scripts/git-hooks/ ... while the checks' own installer
         pointed at the look-alike scripts/githooks/ dir. The two near-identical
         directory names diverged, orphaning the checks."

    R-F1958 added a working hook to `scripts/git-hooks/` and never touched the
    installer, so the diagnosis was recorded and half the fix shipped. Measured
    2026-08-11: `scripts/githooks/pre-commit` still exists as a FROZEN COPY of this
    file's old Python checker (dated Aug 3) — it lacks the R-F3878 C-number gate,
    still carries the R-F3886 NameError that made every check fail open, and lacks
    the R-F3888 false-positive fix.

    So running the documented install command ACTIVATED STALE LOGIC and, worse,
    silently replaced a correct `core.hooksPath` with the orphan — observed live
    while verifying this. An installer that de-installs the working hook is the most
    expensive kind of dead wiring, because using the tool is what breaks it.

    `scripts/githooks/` is deliberately NOT deleted: freeze §26 requires three proofs
    and the quarantine ladder before removing anything. It is recorded here and
    pinned by a test instead.
    """
    hooks_dir = REPO_ROOT / "scripts" / "git-hooks"
    hook_path = hooks_dir / "pre-commit"
    if not hook_path.exists():
        print(f"[pre-commit] ERROR: {hook_path} not found")
        return False
    result = subprocess.run(
        ["git", "config", "core.hooksPath", str(hooks_dir)],
        capture_output=True, text=True, encoding="utf-8", cwd=REPO_ROOT,
    )
    if result.returncode == 0:
        print(f"[pre-commit] Installed: core.hooksPath = {hooks_dir}")
        return True
    print(f"[pre-commit] Install failed: {result.stderr}")
    return False


def main():
    if "--install" in sys.argv:
        return 0 if install_hook() else 1

    if "--check-all" in sys.argv:
        print("[pre-commit] Running --check-all (CI mode)...")
        # R-F3683 — repo-wide secret sweep FIRST. A committed credential is not
        # a code-quality issue to be reported alongside others; it is the one
        # finding that must stop the pipeline on its own.
        secret_issues = check_committed_secrets(_all_repo_source_files())
        if secret_issues:
            print("[pre-commit] VERIFICATION FAILED — COMMITTED SECRET:")
            for issue in secret_issues[:20]:
                print(issue)
            if len(secret_issues) > 20:
                print(f"  ... and {len(secret_issues) - 20} more")
            print("\nRotate the credential, then read it from the environment.")
            return 1
        # R-F3878 — the defect register is a property of the REPO, not of a file
        # set, so it is checked in CI mode too. Wiring only the staged path would
        # leave the register unguarded on every commit that does not touch it —
        # and a collision lands regardless of what else is in the commit.
        c_issues = check_c_number_collisions()
        if c_issues:
            print("[pre-commit] C-NUMBER COLLISION:")
            for issue in c_issues:
                print(issue)
            return 1
        issues = check_all_files()
        if issues:
            print("[pre-commit] FUNCTION VERIFICATION FAILED:")
            for issue in issues[:30]:
                print(issue)
            if len(issues) > 30:
                print(f"  ... and {len(issues) - 30} more")
            return 1
        print(f"[pre-commit] OK — all files checked, no issues.")
        return 0

    # Default: check staged changes (pre-commit hook mode)
    files = get_staged_files()
    if not files:
        return 0

    # Check 0: COMMITTED-SECRET GATE (R-F3683) — runs before everything, because
    # a credential reaching git history cannot be undone by a later commit.
    # Complements check_no_token_default (R-F1824), which matches a fixed list of
    # known fallback strings and skips tests/; this one catches any high-entropy
    # literal bound to a secret-shaped name, tests included.
    secret_issues = check_committed_secrets(files)
    if secret_issues:
        print("[pre-commit] VERIFICATION FAILED — COMMITTED SECRET:")
        for issue in secret_issues:
            print(issue)
        print("\nRotate the credential, then read it from the environment.")
        return 1

    # Check 0a: COMPILE GATE (R-F2135) — fail-fast. A staged .py that compiles
    # but has import-time errors (undefined names, broken imports) must never be
    # committed. This catches the R-F2126 failure class: files that parse OK but
    # reference undefined names. Runs before syntax gate because py_compile is
    # stricter than ast.parse.
    compile_issues = _check_compile_gate(files)
    if compile_issues:
        # R-F2168: emit the "VERIFICATION FAILED" sentinel that the active hook
        # wrapper (scripts/git-hooks/pre-commit) greps for to BLOCK the commit.
        # Previously this printed only "COMPILE GATE FAILED", which the wrapper
        # ignored — so a genuinely broken .py was never blocked here (the
        # gate was toothless). The syntax gate below already used the sentinel.
        print("[pre-commit] VERIFICATION FAILED — COMPILE GATE:")
        for issue in compile_issues:
            print(issue)
        print("\nFix the compile error(s) above before committing — a broken .py breaks import + any deploy (CLAUDE.md §11c).")
        return 1

    # Check 0b: SYNTAX GATE (R-F2127) — fail-fast. A staged .py with a SyntaxError
    # must NEVER be committed: it breaks import and any deploy. Every other check
    # below ast.parse()s and silently skips broken files, so without this gate a
    # corrupted file (e.g. an autonomous annotation campaign inserting comments
    # mid-expression) sails through. Run FIRST and short-circuit — other checks
    # are unreliable on a file that doesn't parse.
    syntax_issues = check_syntax(files)
    if syntax_issues:
        print("[pre-commit] VERIFICATION FAILED:")
        for issue in syntax_issues:
            print(issue)
        print("\nFix the SyntaxError(s) above before committing — broken Python breaks import + any deploy.")
        return 1

    # Check 0c: NODE BOOT SMOKE (R-F2292) — verify server.mjs can import without
    # ReferenceError. This catches the class of bug where a module uses bare
    # shorthand names in an object literal that reference unimported functions.
    # Only runs when server.mjs is staged.
    _server_staged = any(fp.name == "server.mjs" for fp in files)
    if _server_staged:
        _boot_result = subprocess.run(
            [sys.executable, "-c", """
import subprocess as _sp, sys as _sys
_r = _sp.run(
    ['node', '--input-type=module', '-e',
     'try { await import("./server.mjs"); } catch(e) { console.error("BOOT FAILED:", e.message); _sys.exit(1); }'],
    capture_output=True, text=True, timeout=30,
)
if _r.returncode != 0:
    print(_r.stderr[:500])
_sys.exit(_r.returncode)
"""],
            capture_output=True, text=True, timeout=35,
        )
        if _boot_result.returncode != 0:
            print("[pre-commit] VERIFICATION FAILED — NODE BOOT SMOKE:")
            print(f"  server.mjs failed to import. Stderr:")
            print(f"    {_boot_result.stderr[:500]}")
            print("\nFix the ReferenceError/import error before committing.")
            print("Run: node --input-type=module -e \"await import('./server.mjs')\"")
            return 1

    # R-F1961 — per-file ADDED-line numbers + ADDED function names, so the
    # whole-file checks gate only what THIS commit introduces (not pre-existing
    # debt in a touched legacy file). Empty maps fall back to whole-file behavior.
    added_lines_by_file = {}
    changed_funcs = {}
    for fp in files:
        _d = get_staged_diff(fp)
        added_lines_by_file[fp.name] = added_line_numbers(_d)
        changed_funcs[fp.name] = added_func_names(_d)

    issues = []

    # Check 1: Function-name verification (existing)
    for file_path in files:
        diff = get_staged_diff(file_path)
        if not diff:
            continue
        added_lines = extract_added_lines(diff)
        calls = find_function_calls(added_lines)
        for call in calls:
            module_path = resolve_module(call["object"], file_path, call.get("line_num"))
            if module_path is None:
                continue
            # R-F3886 — this said `lines`, which does not exist in THIS scope; the
            # variable here is `added_lines` (the name `lines` belongs to
            # check_all_files(), where this guard call was copied from). The staged
            # path therefore died with `NameError: name 'lines' is not defined` on
            # the first staged .py containing any resolvable call.
            #
            # It failed WORSE than silently: the hook is deliberately fail-open (it
            # blocks only on an explicit "VERIFICATION FAILED" sentinel, so a tooling
            # bug never wedges commits), so the crash meant EVERY local check — all
            # ~12, including the R-F3878 C-number gate — was skipped and the commit
            # allowed. CI stayed green because `--check-all` runs check_all_files(),
            # which never reaches this line. TWO failures had stacked: core.hooksPath
            # unset (R-F3885) AND this crash, so activating the hook alone would have
            # bought nothing.
            #
            # `added_lines` is CORRECT, not merely NameError-free: call["line_num"]
            # is produced by enumerate() over added_lines inside find_function_calls
            # / find_direct_function_calls, so it indexes THAT list, and
            # _is_capability_guarded slices lines[lo:line_num].
            if _is_capability_guarded(added_lines, call["line_num"], call["function"]):
                continue
            # R-F3556 — known dead branches: reported, not fatal, shrink-only.
            if (module_path, call["function"]) in KNOWN_DEAD_CALLS:
                continue
            if not function_exists(module_path, call["function"]):
                rel = file_path.relative_to(REPO_ROOT)
                issues.append(f"  {rel}:{call['line_num']} — {call['code']}")
                issues.append(f"    Function '{call['function']}()' not found in {module_path}")

    # Check 2: Capability test requirement (R-F1124) — R-F1961: ADDED funcs only
    cap_issues = check_capability_tests(files, changed_funcs)
    issues.extend(cap_issues)

    # Check 3: Wiring presence (R-F1268) — whole-file (a module is wired or not)
    wiring_issues = check_wiring_present(files)
    issues.extend(wiring_issues)

    # Check 4: Windows compatibility (R-F1268) — R-F1961: ADDED lines only
    win_issues = check_windows_compat(files, added_lines_by_file)
    issues.extend(win_issues)

    # Check 5: False success detection (R-F1268) — R-F1961: ADDED lines only
    fs_issues = check_false_success(files, added_lines_by_file)
    issues.extend(fs_issues)

    # Check 6: Direct function call verification (R-F1268)
    for file_path in files:
        diff = get_staged_diff(file_path)
        if not diff:
            continue
        added_lines = extract_added_lines(diff)
        calls = find_direct_function_calls(added_lines)
        for call in calls:
            module_path = resolve_module(call["object"], file_path, call.get("line_num"))
            if module_path is None:
                continue
            # R-F3886 — same defect, second staged-path site. See above.
            if _is_capability_guarded(added_lines, call["line_num"], call["function"]):
                continue
            # R-F3556 — known dead branches: reported, not fatal, shrink-only.
            if (module_path, call["function"]) in KNOWN_DEAD_CALLS:
                continue
            if not function_exists(module_path, call["function"]):
                rel = file_path.relative_to(REPO_ROOT)
                issues.append(f"  {rel}:{call['line_num']} — {call['code']}")
                issues.append(f"    Function '{call['function']}()' not found in {module_path}")

    # Check 7: Built-in shadowing (R-F1518)
    shadow_issues = check_builtin_shadowing(files)
    issues.extend(shadow_issues)

    # Check 8: Circuit-breaker presence on outbound HTTP backends (R-F1791)
    cb_issues = check_circuit_breaker(files)
    issues.extend(cb_issues)

    # Check 9: No hardcoded auth-token default — fail closed (R-F1824, audit H2)
    issues.extend(check_no_token_default(files))

    # Check 10: SSRF fetch-boundary on user-controlled URLs (R-F1824, audit C2)
    issues.extend(check_ssrf_fetch_boundary(files))

    # R-F3878 — C-number collisions. Not file-scoped on purpose: the collision is a
    # property of docs/cure/defects.md, and the commit that creates one is usually
    # the commit that adds the heading.
    issues.extend(check_c_number_collisions(files))

    # Check 11: Capability test presence (R-F2135) — AGENTS.md §8.7
    cap_test_issues = check_capability_test_present(files, changed_funcs)
    issues.extend(cap_test_issues)

    # Check 12: PowerShell safety (R-F2135) — anti-hallucination law 19
    ps_issues = check_powershell_safety(files, added_lines_by_file)
    issues.extend(ps_issues)

    if issues:
        print("[pre-commit] VERIFICATION FAILED:")
        for issue in issues:
            print(issue)
        print("\nFix the issues above before committing.")

        # R-F2136: record the first failure in coding_failures RAG so the
        # autonomous coder can learn from pre-commit rejections. Fire-and-forget
        # via subprocess — never blocks the commit rejection.
        try:
            _first = issues[0]
            _check_name = "unknown"
            if "COMPILE ERROR" in _first or "COMPILE GATE" in _first:
                _check_name = "compile_gate"
            elif "capability test" in _first.lower() or "NO capability test" in _first:
                _check_name = "capability_test"
            elif "curl" in _first.lower() or "double-ampersand" in _first.lower():
                _check_name = "powershell_safety"
            elif "SYNTAX" in _first or "SyntaxError" in _first:
                _check_name = "syntax_gate"
            elif "wiring" in _first.lower():
                _check_name = "wiring"
            elif "shadow" in _first.lower():
                _check_name = "builtin_shadowing"
            elif "circuit breaker" in _first.lower() or "breaker" in _first.lower():
                _check_name = "circuit_breaker"
            elif "token" in _first.lower() or "aria-internal" in _first:
                _check_name = "token_default"
            elif "SSRF" in _first or "ssrf" in _first:
                _check_name = "ssrf_fetch"
            elif "Windows" in _first or "windows" in _first:
                _check_name = "windows_compat"
            _file_hint = ""
            for _fp in files:
                if _fp.name in _first:
                    _file_hint = str(_fp)
                    break
            if not _file_hint and files:
                _file_hint = str(files[0])
            subprocess.run(
                [sys.executable, "-c",
                 f"import sys; sys.path.insert(0, 'scripts'); "
                 f"from pre_commit_checks import REPO_ROOT; "
                 f"sys.path.insert(0, str(REPO_ROOT)); "
                 f"from aria_service.intel.coding_rag_indexer import record_precommit_failure; "
                 f"record_precommit_failure("
                 f"check_name={_check_name!r}, "
                 f"file_path={_file_hint!r}, "
                 f"error_message={_first[:300]!r})"],
                capture_output=True, timeout=10,
                cwd=REPO_ROOT,
            )
        except Exception:
            pass  # Never let RAG recording block the commit rejection

        return 1

    print(f"[pre-commit] OK — {len(files)} files checked.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
