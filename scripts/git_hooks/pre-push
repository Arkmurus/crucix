#!/usr/bin/env bash
# R-F1773 — UNIVERSAL deploy-verification hook. Records EVERY push to main as a
# deploy-intent in ARIA's brain, so the proprioception loop can verify the commit
# actually went live (deploy_verification_failure gap if it never does). This closes
# the confabulation hole a RAW `git push` slipped through (R-F1770): no push — raw,
# ci_deploy, or self_improve — can claim "deployed" without machine proof anymore.
#
# NON-BLOCKING + FAIL-SAFE: always exit 0. The POST is best-effort (short timeout,
# backgrounded); a slow/unreachable brain or missing token NEVER blocks or fails the
# push. This only *records intent* — verification happens server-side on a timer.
set -uo pipefail

REPO="$(git rev-parse --show-toplevel 2>/dev/null || echo /c/code/crucix)"
ENVF="$REPO/.env"
TOK=""; BRAIN="https://aria-intel.fly.dev"
if [ -f "$ENVF" ]; then
  TOK=$(grep -E '^ARIA_INTERNAL_TOKEN=' "$ENVF" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '\r')
  B=$(grep -E '^ARIA_BRAIN_URL=' "$ENVF" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '\r')
  [ -n "${B:-}" ] && BRAIN="$B"
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      # skip deletes (local_sha all zeros)
      case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
      esac
      if [ -n "$TOK" ] && [ -n "$local_sha" ]; then
        ( curl -s --max-time 6 -X POST "$BRAIN/api/aria/deploy/intent" \
            -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" \
            -d "{\"commit_sha\":\"$local_sha\",\"source\":\"pre_push_hook\"}" \
            >/dev/null 2>&1 || true ) &
        echo "[R-F1773] recorded deploy-intent for ${local_sha:0:8} → brain (verification on timer)"
      fi
      ;;
  esac
done

exit 0
