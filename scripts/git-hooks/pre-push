#!/bin/sh
# R-F559 pre-push hook (+ R-F1773 deploy-intent recording).
#
# Install via: python scripts/install_git_hooks.py
# Or manually: git config core.hooksPath scripts/git-hooks
#
# Skip via: git push --no-verify   (use only when explicitly authorised)

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# R-F1773 — capture the pushed refs from stdin up-front (git feeds the hook
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines on stdin). We record a
# UNIVERSAL deploy-intent for every push to main so the proprioception loop can
# verify the commit actually went live (deploy_verification_failure gap if not).
# This closes the confabulation hole a RAW `git push` (R-F1770) slipped through.
PUSH_REFS="$(cat)"

# C-38 (R-F3931) — C-34 fixed this resolution in pre-commit and NOT here, which is
# why every push in that session needed a manual PATH shim. `--show-toplevel` is the
# WORKTREE root and a worktree has no .venv, so this fell through to `python3` — on
# Windows the App Execution Alias shim, which exits non-zero (measured 49). Under
# `set -e` that ABORTS the hook and blocks the push outright: pre-push fails CLOSED,
# so the same missing interpreter that made pre-commit skip everything makes this
# refuse everything. `--git-common-dir` points at the MAIN checkout's .git for every
# worktree, so its parent is the main working tree.
MAIN_ROOT=""
_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -n "$_COMMON_DIR" ]; then
    MAIN_ROOT="$(dirname "$_COMMON_DIR")"
fi

# Detect available Python interpreter — prefer repo venv.
if [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then
    PY="$REPO_ROOT/.venv/Scripts/python.exe"
elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PY="$REPO_ROOT/.venv/bin/python"
elif [ -n "$MAIN_ROOT" ] && [ -x "$MAIN_ROOT/.venv/Scripts/python.exe" ]; then
    PY="$MAIN_ROOT/.venv/Scripts/python.exe"
elif [ -n "$MAIN_ROOT" ] && [ -x "$MAIN_ROOT/.venv/bin/python" ]; then
    PY="$MAIN_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=python
fi

echo "[R-F559 pre-push] running verifier via $PY"
"$PY" "$REPO_ROOT/scripts/verify_commit.py" --fast

# ── R-F1773 — record deploy-intent (best-effort, NEVER blocks/fails the push) ──
# Only runs after the verifier passes (a push that won't happen needs no intent).
record_deploy_intent() {
    ENVF="$REPO_ROOT/.env"
    TOK=""; BRAIN="https://aria-intel.fly.dev"
    if [ -f "$ENVF" ]; then
        TOK=$(grep -E '^ARIA_INTERNAL_TOKEN=' "$ENVF" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '\r')
        B=$(grep -E '^ARIA_BRAIN_URL=' "$ENVF" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '\r')
        [ -n "$B" ] && BRAIN="$B"
    fi
    [ -n "$TOK" ] || return 0
    printf '%s\n' "$PUSH_REFS" | while read -r local_ref local_sha remote_ref remote_sha; do
        case "$remote_ref" in
            refs/heads/main|refs/heads/master)
                case "$local_sha" in
                    0000000000000000000000000000000000000000|"") continue ;;
                esac
                curl -s --max-time 6 -X POST "$BRAIN/api/aria/deploy/intent" \
                    -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" \
                    -d "{\"commit_sha\":\"$local_sha\",\"source\":\"pre_push_hook\"}" \
                    >/dev/null 2>&1 &
                echo "[R-F1773] recorded deploy-intent for $(printf '%s' "$local_sha" | cut -c1-8) -> brain (verified on timer)"
                ;;
        esac
    done
}
( record_deploy_intent ) || true

exit 0
