# R-F832 (2026-05-23) — Dockerfile for the `aria-web` Fly app.
#
# Replaces seenode by running the Node monolith (server.mjs + lib/ +
# apis/ + middleware/ + dashboard/ + public/) on Fly.io with persistent
# volumes for users.json / sessions.json / runs/ (no more ephemeral-disk
# auth races per audit W18).
#
# Deliberately excludes:
#   - services/wa-listener/  → that's the `aria-wa` Fly app (R-F833)
#   - aria_service/          → Python brain, runs on `aria-intel`
#   - scripts/train/         → RunPod-only training scripts
#   - frontend/dist/         → dead Angular SPA (audit W10 — deleted in R-F832)
#   - data/wedge_stacks/, runs/  → ephemeral / build artefacts
#
# R-F1799 (2026-06-23, aria-web audit #14) — MULTI-STAGE build. The build
# toolchain (python3/make/g++/git) is only needed to compile native npm
# modules; keeping it in the deployed image bloats the attack surface. Stage 1
# (builder) compiles node_modules; stage 2 (runtime) ships ONLY the node
# runtime + cert bundle + built modules + app code. No compilers in production.
#
# Build: `flyctl deploy --config fly.web.toml`

# ── Stage 1: builder (has the toolchain; compiles native modules) ────────────
FROM node:22-slim AS builder

WORKDIR /app

# Build deps for native modules (baileys + transitive native code).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the manifest first so npm install is cached across code-only commits.
COPY package.json package-lock.json* ./

# Production install — drop devDependencies, install optionals so the
# pdf/excel/imap/whatsapp paths work.
RUN npm install --include=optional --omit=dev

# ── Stage 2: runtime (NO toolchain — just node + certs + built modules) ───────
FROM node:22-slim AS runtime

# R-F846 (2026-05-23) — build-time identity (mirrors aria-intel R-F513).
# server.mjs reads ARIA_BUILD_GIT_SHA at boot so /api/health.build_rev reports
# the real SHA. Falls back to .git/HEAD at runtime (R-F589).
ARG ARIA_BUILD_GIT_SHA=unknown
ARG ARIA_BUILD_R_TAG=
ENV ARIA_BUILD_GIT_SHA=$ARIA_BUILD_GIT_SHA
ENV ARIA_BUILD_R_TAG=$ARIA_BUILD_R_TAG

# Runtime keeps the CA cert bundle (outbound HTTPS) and git — server.mjs and
# lib/self/updater.mjs shell out to `git` at runtime (build_rev fallback +
# self-updater). It DROPS the compiler toolchain (python3/make/g++), which is
# the real attack-surface concern and is only needed to compile native modules
# in the builder stage.
# R-F2903 — fonts are REQUIRED for the Telegram signal card.
# node:22-slim ships no fonts and no fontconfig (/usr/share/fonts does not exist,
# fc-list is absent). sharp/librsvg then rasterises every glyph as a tofu box: the
# PNG is produced, it is the right dimensions, it has a plausible byte count — and it
# is completely unreadable. Verified live 2026-07-23 by pulling the rendered card out
# of the running container and looking at it; every byte-level check had passed.
# fonts-dejavu-core covers Latin Extended-A, which the live corpus needs for Hungarian
# (ő, ű), Portuguese and Turkish buyer names. fontconfig is what librsvg resolves
# font-family through — without it the family list is meaningless.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates fontconfig fonts-dejavu-core \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Built node_modules from the builder (native modules compiled against the
# identical node:22-slim base → ABI/glibc-compatible).
COPY --from=builder /app/node_modules ./node_modules

# Manifests + application code. EXPLICIT copies (not COPY . .) so the
# Dockerfile documents the deployed surface — anything not listed is NOT shipped.
COPY package.json package-lock.json* ./
COPY server.mjs ./
COPY crucix.config.mjs ./
COPY lib/ ./lib/
COPY apis/ ./apis/
COPY middleware/ ./middleware/
COPY dashboard/inject.mjs ./dashboard/
COPY dashboard/public/ ./dashboard/public/
COPY public/ ./public/

# R-F589 — SHA-resolution from .git files (read, not shelled to `git`), so
# server.mjs reports the running commit even when --build-arg was omitted.
COPY .git/HEAD .git/HEAD
COPY .git/refs .git/refs
COPY .git/packed-refs* .git/

# Persistent data volume mount-point (Fly mounts aria_web_data at /data).
RUN mkdir -p /data

ENV PORT=3117 \
    NODE_ENV=production \
    PERSIST_DIR=/data

EXPOSE 3117

# Single node process: Express + socket.io + cron jobs (no separate worker).
CMD ["node", "server.mjs"]
