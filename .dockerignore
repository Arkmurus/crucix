node_modules
npm-debug.log*
.git
# R-F589 (2026-05-16) — exceptions so the image carries enough of .git
# to resolve HEAD at runtime. Lets main.py fall back to a real SHA when
# --build-arg ARIA_BUILD_GIT_SHA was omitted (manual flyctl deploy with
# no wrapper). Adds ~50KB to image.
!.git/HEAD
!.git/refs
!.git/packed-refs
.gitignore
.github
.omc
# R-F4149 — bound deploy contexts to runtime inputs. These local environments,
# agent stores, and caches are never copied by any production Dockerfile.
.agent_bridge/
.aria/
.claude/
.mypy_cache/
.venv/
# R-F4145 — local pytest and agent scratch trees can contain unreadable
# directories; they are never runtime inputs and must not enter Fly contexts.
.scratch/
.pytest_cache/
data/eval_reports/pytest-*/
data/training/pytest_tmp_*/
# Production images copy only the reservation ledger from data/. Exclude every
# generated checkpoint, evaluation artifact, state snapshot, and training file,
# then explicitly restore that required runtime input.
data/*
!data/r_number_reservations.json
.env
.env.*
!.env.example
runs/
docs/
*.md
!README.md
# R-F1959 — the autonomous self-coder (sovereign_llm._load_playbook) reads these
# at runtime to bind itself to the playbook. Without these un-ignores, *.md
# above strips them from the image and the binding silently degrades to no-op.
!CLAUDE.md
!AGENTS.md
LICENSE
