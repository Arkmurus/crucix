# ARIA service — environment variable reference
# Copy to aria_service/.env (gitignored) and fill in real values for local dev.
# This file is specific to the ARIA Python FastAPI service. The top-level
# .env.example covers the older crucix dashboard variables.
#
# DO NOT commit .env, .env.local, or any file with real secrets.

# ════════════════════════════════════════════════════════════════════
# REQUIRED — service won't start (or will refuse all requests) without these
# ════════════════════════════════════════════════════════════════════

# LLM provider — primary inference engine.
# Supported: deepseek, openai, anthropic, ollama, gemini.
# Production default: deepseek (cheapest, best ratio for ARIA workloads).
LLM_PROVIDER=deepseek

# API key for the chosen provider. For deepseek, this is also DEEPSEEK_API_KEY.
LLM_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Bearer token enforced on every fly.io ARIA endpoint by the router-wide
# auth dependency. 64-char hex string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# This token MUST also be set on the seenode bridge so the proxy can call
# fly.io. Mismatched values cause every request to return 401.
ARIA_API_TOKEN=replace-with-64-char-hex

# Bearer token enforced on the seenode-side WhatsApp listener routes
# (/api/wa-listener/*). Different from ARIA_API_TOKEN. Generate the same
# way. Without this set, the listener routes return 500 by design (the
# 'aria-internal' hardcoded fallback was removed 2026-04-09 — fail-closed).
ARIA_INTERNAL_TOKEN=replace-with-64-char-hex

# Redis — used for session history, knowledge facts, intel ledger,
# correction learner, and most persistent state outside chromadb.
REDIS_URL=redis://localhost:6379

# ════════════════════════════════════════════════════════════════════
# RECOMMENDED — gracefully degrades without these but loses key features
# ════════════════════════════════════════════════════════════════════

# Brave Search API — primary web_search provider for deep_research.
# Free tier: 2000 queries/month, 1 q/s.
# Sign up: https://api.search.brave.com/app/dashboard
# Without it, web_search falls back to DuckDuckGo HTML scraping which is
# rate-limited (Phase 2 deep_research is starved without this).
BRAVE_SEARCH_API_KEY=BSA...

# Fallback LLM keys — enable auto-failover when the primary provider has
# an outage. Set the keys you have; the fallback chain skips any provider
# whose key is unset.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# ════════════════════════════════════════════════════════════════════
# OPTIONAL — feature flags (sensible defaults)
# ════════════════════════════════════════════════════════════════════

# Server bind
ARIA_PORT=8000
ARIA_HOST=0.0.0.0

# Conditional addenda — set to "0" to disable individually
ARIA_PMESII_ENABLED=1
ARIA_ANALYTIC_PRINCIPLES=1
ARIA_NEGOTIATION_PRINCIPLES=1
ARIA_GHOST_DETECTION=1
ARIA_CONTRACT_REVIEW=1
ARIA_RESEARCHER_PRINCIPLES=1
ARIA_CORRECTION_LEARNER=1
ARIA_STALE_KNOWLEDGE_ALERTS=1
ARIA_CONFIDENCE_FOOTER=1

# Semantic search index build at startup. Set to "0" if startup is timing
# out under GIL contention from sentence-transformers .encode() (past
# incident 2026-04-08). When disabled, call:
#   POST /api/aria/admin/rebuild-semantic-index
# manually after the server is up to populate the index from knowledge.facts.
ARIA_SEMANTIC_INDEX_BUILD=1

# RAG store backfill — set to "true" to ingest historical chats into
# chromadb on startup. Default false (was a startup OOM source).
ARIA_RAG_BACKFILL_ENABLED=false

# ════════════════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ════════════════════════════════════════════════════════════════════
#
# fly.io aria-intel: set all REQUIRED + RECOMMENDED via `flyctl secrets set`
# seenode bridge:    set ARIA_API_TOKEN, ARIA_INTERNAL_TOKEN
# Local dev:         copy this file to aria_service/.env
#
# Smoke test that secrets are correctly set on the live machine:
#   curl https://aria-intel.fly.dev/api/admin/env-check
# (returns SHA-256 fingerprint of ARIA_API_TOKEN, NOT the token itself)
