# R-F809 + R-F813 + R-F818 — Dockerfile for aria-trainer Fly app
#
# Image used to fine-tune ARIA-LLM on A100 80GB GPU machines on Fly.io.
# Replaces the RunPod path documented in [[runpod_signed_up]] —
# consolidates all compute on Fly per the operator's 2026-05-22
# "everything on Fly.io" architectural directive.
#
# Build: flyctl deploy --config fly.trainer.toml
#   (does not start the GPU machine — that's a manual `flyctl machine
#   run` step, see scripts/train/README.md)
#
# R-F818 (2026-05-22 23:30Z) — image-size fix
# ──────────────────────────────────────────────
# Live failure: Fly machine pull repeatedly logged
#   "Not enough space to unpack image, possibly exceeds maximum of 8GB
#    uncompressed"
# at 22:13Z, 22:27Z, 22:55Z, 22:59Z, 23:08Z, 23:15Z.
# Fly's per-machine image limit is 8GB uncompressed; my prior CUDA-runtime
# + DIY PyTorch install built to 8.7GB. Five machine launches all
# auto-destroyed for the same reason — the symptom was "stuck in
# `created` state" but the actual cause was image too big.
#
# Fix: switch from `nvidia/cuda:12.1.0-runtime-ubuntu22.04` (3GB) + DIY
# PyTorch wheel install (3.5GB) to the official `pytorch/pytorch` base
# which ships Python + CUDA + PyTorch pre-baked (~4GB) and adds only
# ~1.5GB for transformers/trl/peft/bitsandbytes. Total target ≤6GB,
# comfortably under the 8GB ceiling.

FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/hf_cache \
    TRANSFORMERS_CACHE=/data/hf_cache \
    HUGGINGFACE_HUB_CACHE=/data/hf_cache

# System deps. pytorch/pytorch already has python3 + git + curl + the
# CUDA toolkit. We only need a couple of utilities for the corpus +
# checkpoint transfer steps.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Training stack — exact versions from [[runpod_signed_up]] step 3.
# Pinned because trl + transformers + peft + bitsandbytes have moved
# breaking-changes 3 times in the past year; reproducibility matters.
# `--no-deps` avoids re-resolving torch (already pinned by base image).
RUN pip install --no-cache-dir \
        transformers==4.45.0 \
        trl==0.11.0 \
        peft==0.13.0 \
        accelerate==1.0.0 \
        bitsandbytes==0.44.1 \
        datasets==3.0.0 \
        sentencepiece \
        protobuf \
        huggingface_hub

# Optional: vLLM for serving (commented out — adds ~3GB to image; only
# install when the serving R-number ships and the trainer machine
# starts double-dutying as inference. Until then keep image lean.)
#RUN pip install --no-cache-dir vllm==0.6.3

WORKDIR /workspace

# Copy the training scripts. Same scripts work on Fly + RunPod —
# they're cloud-agnostic by design.
COPY scripts/train/ /workspace/scripts/train/
COPY scripts/train/README.md /workspace/README.md

# R-F813 fix: `/bin/bash` exits immediately without a TTY, which made
# `flyctl deploy` crash-loop the machine and never bind. Use sleep
# infinity so the machine stays running. Operator triggers training
# via either:
#   flyctl ssh console -a aria-trainer -C "bash /workspace/scripts/train/fly_train_pipeline.sh"
#   OR by launching a fresh machine with `--command` override that runs
#   the pipeline script directly.
CMD ["sleep", "infinity"]
