# ============================================
# Crucix Intelligence Engine — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === OSINT Source API Keys ===

# Federal Reserve Economic Data (free: fred.stlouisfed.org/docs/api)
FRED_API_KEY=
# NASA FIRMS fire data (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# Energy Information Administration (free: api.eia.gov/register)
EIA_API_KEY=
# Maritime AIS data (aisstream.io)
AISSTREAM_API_KEY=
# Armed Conflict Location & Event Data (acleddata.com/user/register)
ACLED_EMAIL=
# OAuth2 password grant (API keys deprecated Sept 2025)
ACLED_PASSWORD=
# Cloudflare Radar internet outages & traffic anomalies (free: dash.cloudflare.com/profile/api-tokens, Account Analytics Read)
CLOUDFLARE_API_TOKEN=

# Intel Search Engine
# Brave Search API — free tier 2000 queries/month (search.brave.com/api)
# Without this key, search falls back to SearXNG public instances (no key needed)
BRAVE_API_KEY=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=5
# Public URL of this server (used by Telegram bot to fetch /api/data)
# Set to your Seenode/VPS domain, e.g. https://crucix.yourdomain.com
APP_URL=
# Set to 'true' to enable self-ping keep-alive (only needed on free-tier hosts that sleep)
SELF_PING=false

# === LLM Layer (optional) ===
# Enables AI-enhanced trade ideas and breaking news Telegram alerts.
# Provider options: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b
LLM_MODEL=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === ARIA LLM cost cap ===
# Hard ceiling on total LLM spend (Anthropic + DeepSeek + OpenAI + Gemini +
# Groq) across a calendar month. Enforced by MeteredProvider — calls that
# would exceed the cap raise MonthlyCostCapExceeded. Default: $100.
ARIA_MONTHLY_CAP_USD=100
# Set to 1 to log but NOT block when the cap is hit (investigation mode).
ARIA_MONTHLY_CAP_WARN_ONLY=0

# === ARIA Python Service (optional) ===
# If set, all /api/aria/* routes proxy to the Python ARIA service first.
# Run: python -m aria_service.main (port 8000)
ARIA_SERVICE_URL=
# Old Flask brain service (legacy, use ARIA_SERVICE_URL instead)
BRAIN_SERVICE_URL=

# === Telegram Alerts (optional, requires LLM) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public broadcast channel for Golden Intel only. Keep separate from TELEGRAM_CHAT_ID.
TELEGRAM_CHANNEL_ID=


# ════════════════════════════════════════════════════════════════════════
# === ARIA backend (fly.io aria-intel) — added R-F149 2026-05-10 ===
# These were missing from .env.example but are referenced by the running
# code. Set via `fly secrets set -a aria-intel <NAME>=<value>` for prod.
# ════════════════════════════════════════════════════════════════════════

# === LLM fallback chain (priority order: ARIA-LLM → Anthropic → DeepSeek
# === → Groq → OpenAI → Gemini → optional Ollama). Set as many as possible
# === for resilience — chain stays up while at least one provider is healthy.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Sovereign LLM (ARIA-LLM v0.0+). When set, takes FIRST PRIORITY in chain.
# Phase B gating — leave unset until Phase A exits. Per RunPod runbook.
ARIA_LLM_URL=
ARIA_LLM_KEY=sovereign
ARIA_LLM_MODEL=aria-llm-v0.1
# Local LLM via Ollama / vLLM — independence-roadmap Phase 1
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b-instruct

# === Auth tokens — rotate on suspected leak (per memory rotate_aria_internal_token) ===
ARIA_API_TOKEN=
ARIA_INTERNAL_TOKEN=
ARIA_AUDIT_SIGNING_KEY=

# === Sources requiring registration (Phase A gate #5) ===
# World Bank debarred firms — leave UNSET in normal operation (R-F155 2026-05-10).
# The Firm360 API at apigwext.worldbank.org/dvsvc is an INTERNAL Adobe
# Experience Manager backend powering the public debarred-firms search
# page (projects.worldbank.org/en/projects-operations/procurement/
# debarred-firms). It is NOT a publicly-registerable developer API.
# Verified 2026-05-10: apigwext.worldbank.org/ → 403, debarred-firms page
# has zero mention of API access, data.worldbank.org/about/data-catalog/api
# → 404. There is no self-service signup. To attempt access, email
# data@worldbank.org or the Integrity VP — expect 1-3 weeks if any reply.
# In the meantime, ARIA degrades gracefully through OpenSanctions which
# aggregates WB debarments via the `wb_debarred` dataset — the DD signal
# is preserved, only primary-source citation is lost.
WORLDBANK_SUBSCRIPTION_KEY=
# OpenSanctions full dataset access (free dev tier at opensanctions.org)
OPENSANCTIONS_API_KEY=
# SAM.gov — US federal procurement registry
SAM_GOV_API_KEY=

# === Feature flags — gated by operator (per autonomy doctrine) ===
# Autonomous engine — DEFAULT 0. Do NOT enable until $30/3-day burn
# attributed via /cost/monthly top-calls (per cost_cap_and_autonomy_gate.md)
ARIA_AUTONOMOUS_ENABLED=0
# Human-like portal signup agent. Keep OFF for MVP web stability; vault/source
# ingestion still works without this. Enable only after brain endpoint latency is stable.
ARIA_PORTAL_REGISTRATION_ENABLED=0
# Output harvester — DEFAULT 0. Set to 1 after 3-7 days harvest validation
# (Phase A gate #5 final env var; gates Phase B SFT corpus accumulation)
ARIA_OUTPUT_HARVEST_ENABLED=0
# Chat training capture (per session_2026_04_22_evening memory) — opt-in
ARIA_CHAT_TRAIN_CAPTURE_TEXT=0
# DD orchestrator gates
ARIA_DD_ORCHESTRATOR_ENABLED=1
ARIA_DD_COST_CAP_USD=0.50
ARIA_DD_DEEP_RESEARCH=1
# Layer 5c commercial coherence — set to 0 to bypass
ARIA_LAYER_5C_ENABLED=1
# Absorption-quarantine — comma-separated module names to gate (per absorption_quarantine.py)
ARIA_ABSORPTION_QUARANTINE_MODULES=

# === WhatsApp counterparty mirror (per pending_channel_mirror_activation) ===
# Comma-separated WA group JIDs to mirror messages from
ARIA_MIRROR_GROUPS=
# Comma-separated counterparty contact phones (E.164 + @s.whatsapp.net)
ARIA_COUNTERPARTY_CONTACTS=
# Threshold (0.0-1.0) above which deception score triggers escalation
ARIA_DECEPTION_THRESHOLD=0.6

# ════════════════════════════════════════════════════════════════════════
# === SEENODE backend (sweep-side, Node.js) ===
# Set via the seenode dashboard env var UI — no CLI per memory.
# ════════════════════════════════════════════════════════════════════════

# HMAC-signs PDF audit reports (R-F43). Without it, PDFs carry an explicit
# UNSIGNED warning footer. Generate with `openssl rand -hex 48`.
# Distinct from ARIA_AUDIT_SIGNING_KEY (Python audit-log chain) by design.
REPORT_SIGNING_KEY=

# === Upstash Redis (managed, NOT self-hosted — per upstash_redis_provider) ===
# Cluster: adapted-ostrich-92296. Eviction OFF (forever-memory guarantee).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === SMTP backup (per session_2026_04_26 — daily 04:00 UTC memory snapshot) ===
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_BACKUP_TO=
