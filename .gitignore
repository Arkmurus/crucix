# Dependencies
node_modules/
frontend/node_modules/
# frontend/dist/ — committed so Seenode (no Docker) can serve it directly

# Python bytecode caches
__pycache__/
*.pyc
*.pyo

# Environment (contains API keys)
.env
apis/.env

# Runtime data
runs/
output/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude Code
.claude/
CLAUDE.md
AGENTS.md
# Heredoc workaround scratch file used by Claude Code when committing
# multi-line messages with apostrophes (avoids bash quoting issues).
# Should never be committed.
.git-commit-msg.tmp


# Playwright
.playwright-cli/

# Logs
*.log
npm-debug.log*


# Package lock (optional — remove this line if you want deterministic installs)
# package-lock.json

# Backup files
*.bak

# Local maintainer notes
MAINTAINER_DECISIONS.local.md

# Local deploy config
dashboard/public/vercel.json

# Tier C ingest scheduler state (per-machine, not source-controlled)
aria_service/cli/.tier_c_state.json

# R-F570: generated at build time by sync.mjs from local git;
# never source-controlled.
build_rev.txt

# R-F712 (2026-05-19) — operator-local files that kept appearing in
# `git status` untracked and risked accidental commit:
#   .aria-token     — bearer-token cache (operator workstation)
#   .adv_post.json  — adversarial-post CLI scratch artefact
.aria-token
.adv_post.json

# R-F832 (2026-05-23) — audit W25: scratch corpus tarballs generated
# during the RunPod ARIA-LLM fine-tune workflow. ~6MB combined. Local
# only — should never be committed (would bloat the repo + contain
# operator chat content). Per scripts/train/RUNPOD.md the operator
# regenerates these on demand by tar-ing /data/aria_training from
# aria-intel.
corpus.tar.gz
corpus_v2.tar.gz
corpus.b64
corpus_clean.tar.gz

# Operator's local SSH key for RunPod pod access — generated on
# demand by the autonomous pod-launch flow, never source-controlled.
runpod_aria
runpod_aria.pub

# R-F970 (2026-05-28) — session-scratch monitoring/report artefacts written
# during live log-watch sessions (leading-underscore convention at repo root).
# Operator-local, regenerated each session; never source-controlled. (The
# matching *.log monitor stream is already covered by the Logs section above.)
/_monitor_*.md
/_monitoring_*.md
/_full_pytest_*.txt
/_inspect_*.py

# R-F970 — runtime-learned regression signatures. constitutional_validator.py
# writes these to /data on fly; on a local checkout (no /data mount) it falls
# back to data/learned_attack_signatures.json. Runtime state, not source.
data/learned_attack_signatures.json

# R-F988 — pip editable-install artifact for the aria CLI (not source)
*.egg-info/

# R-F1478: runtime state + session scratch — never source. These were getting
# swept into git by ci_deploy's catch-all `git add -A` (agent DBs can hold PII;
# the _*.md files are Claude<->ARIA session comms). Ignore so no deploy commits them.
data/*.db
data/*.db-shm
data/*.db-wal
data/_*.md

# R-F990 — Claude<->ARIA mailbox (runtime messages, not source)
.agent_bridge/

# stray/scratch from ARIA sessions
/exit
/_*.py

# R-F1808 IAST run artifacts
scripts/iast/_*.jsonl
scripts/iast/_*.log

# R-F1902 — comprehensive runtime/debug junk guard. ARIA's commit 31eaa8e2
# (R-F1896..1900) blanket-`git add -A`'d ~61 junk files into origin/main —
# _eu_sample.xml (172k lines), a Windows .lnk, _gh_logs.zip, _bridge_reply.txt,
# .aria/ runtime metrics, scripts/_*.out, data/training/dataset_*.json, etc.
# (the recurring problem R-F1478 logged a Gap for). These patterns stop the next
# blanket-add from re-sweeping them. Root-anchored where possible so legit
# package files (e.g. aria_service/intel/_snapshot_throttle.py) are unaffected.
# NOT ignored (meaningful, left to operator/ARIA): data/aria_training/coder_verifiable_gold.jsonl,
# public/endpoint-manifest.json.
# (.gitignore has NO inline comments — patterns only, one per line.)
# all root-level _scratch (xml/json/txt/zip/sh/dirs); no legit root file starts with _
/_*
# Windows shortcuts — never source
*.lnk
# runtime agent metrics dir
.aria/
# deploy-pipeline runtime marker
.last_deploy_sha
# debug scan workspaces
_test_scan_*/
# data-dir scratch (_n1l4_port.txt, _v04_pod_id.txt, ...)
data/_*
# training-run scratch datasets
data/training/dataset_*.json
# training scratch
data/training/_*.jsonl
# partial/in-flight training files
data/training/*.partial.jsonl
# eval scratch (_v0_2_verdict.txt, ...)
data/eval_reports/_*
# partial eval outputs
data/eval_reports/*.partial.jsonl
# eval/test capture dumps (_eval_*.out, _rf*.out, ...)
scripts/_*.out
