# Should never be committed.
.git-commit-msg.tmp


# Playwright
.playwright-cli/

# Logs
*.log
npm-debug.log*


# Package lock (optional — remove this line if you want deterministic installs)
# package-lock.json

# Backup files
*.bak

# Local maintainer notes
MAINTAINER_DECISIONS.local.md

# Local deploy config
dashboard/public/vercel.json

# Tier C ingest scheduler state (per-machine, not source-controlled)
aria_service/cli/.tier_c_state.json

# R-F570: generated at build time by sync.mjs from local git;
# never source-controlled.
build_rev.txt

# R-F712 (2026-05-19) — operator-local files that kept appearing in
# `git status` untracked and risked accidental commit:
#   .aria-token     — bearer-token cache (operator workstation)
#   .adv_post.json  — adversarial-post CLI scratch artefact
.aria-token
.adv_post.json

# R-F832 (2026-05-23) — audit W25: scratch corpus tarballs generated
# during the RunPod ARIA-LLM fine-tune workflow. ~6MB combined. Local
# only — should never be committed (would bloat the repo + contain
# operator chat content). Per scripts/train/RUNPOD.md the operator
# regenerates these on demand by tar-ing /data/aria_training from
# aria-intel.
corpus.tar.gz
corpus_v2.tar.gz
corpus.b64
corpus_clean.tar.gz

# Operator's local SSH key for RunPod pod access — generated on
# demand by the autonomous pod-launch flow, never source-controlled.
runpod_aria
runpod_aria.pub

# R-F970 (2026-05-28) — session-scratch monitoring/report artefacts written
# during live log-watch sessions (leading-underscore convention at repo root).
# Operator-local, regenerated each session; never source-controlled. (The
# matching *.log monitor stream is already covered by the Logs section above.)
/_monitor_*.md
/_monitoring_*.md
/_full_pytest_*.txt
/_inspect_*.py

# R-F970 — runtime-learned regression signatures. constitutional_validator.py
# writes these to /data on fly; on a local checkout (no /data mount) it falls
# back to data/learned_attack_signatures.json. Runtime state, not source.
data/learned_attack_signatures.json
